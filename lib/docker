[[ -n "${_IS_LIB_DOCKER_LOADED:-}" ]] && return 0
_IS_LIB_DOCKER_LOADED=1

DAEMON_CONFIG_PATH=/etc/docker/daemon.json
INIT_TASK_COMMENT='Confirgure Docker Logging Storage Limits'

apply_daemon_config () {
  local new_config=$1

  printf '%s\n' "$new_config" > "$DAEMON_CONFIG_PATH" || return 1

  log info 'restarting docker services'
  systemctl restart docker || return 1
}

backup_daemon_config () {
  if [[ -f "$DAEMON_CONFIG_PATH" ]]; then
    cp -a "$DAEMON_CONFIG_PATH" "$DAEMON_CONFIG_PATH.bak" || return 1
  fi
}

create_post_init_task_for_docker_daemon_config () {
  local script_directory=$1

  if [ $# -lt 1 ]; then
    log fail "create_post_init_task_for_docker_daemon_config requires a directory path"
    log info "  Example usage:"
    log info "    create_post_init_task_for_docker_daemon_config \"/path/to/script_directory/\""
    return 1
  fi

  log info 'creating post init task to configure docker logging'

  if ! does_post_init_task_for_docker_daemon_config_exist; then
    midclt call initshutdownscript.create '{
      "type": "SCRIPT",
      "script": "'"$script_directory"'configure_docker.sh",
      "when": "POSTINIT",
      "enabled": true,
      "timeout": 120,
      "comment": "'"$INIT_TASK_COMMENT"'"
    }'
  fi
}

does_post_init_task_for_docker_daemon_config_exist () {
  midclt call initshutdownscript.query | jq -e --arg c "$INIT_TASK_COMMENT" 'any(.[]; .comment == $c)' >/dev/null
}

get_daemon_config() {
  if [[ ! -s "$DAEMON_CONFIG_PATH" ]]; then
    echo '{}'
    return 0
  fi

  jq . "$DAEMON_CONFIG_PATH" || return 1
}

make_logging_config () {
  local current_config=$1

  jq --argjson current_config "$current_config" -n '
    $current_config * {"log-opts": {"max-size": "256m", "max-file": "4"}}
  ' || return 1
}

wait_for_docker_service () {
  for i in $(seq 1 120); do
    systemctl is-active --quiet docker && docker info >/dev/null 2>&1 && break
    sleep 5
  done
}
