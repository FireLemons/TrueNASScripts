[[ -n "${_IS_LIB_AUTH_LOADED:-}" ]] && return 0
_IS_LIB_AUTH_LOADED=1

verify_non_sudo_user () {
  if [ "$EUID" -eq 0 ]; then
    log fail "script cannot be ran as sudo"
    log info "  Exiting"

    exit 1
  fi
}

verify_sudo_user () {
  if [ "$EUID" -ne 0 ]; then
    log fail "script must be as sudo"
    log info "  Exiting"

    exit 1
  fi
}
