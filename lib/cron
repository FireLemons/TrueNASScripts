[[ -n "${_IS_LIB_CRON_LOADED:-}" ]] && return 0
_IS_LIB_CRON_LOADED=1

print_cron_create_help () {
  log info 'Usage:'
  log info '  truenas_cron_create <cron string> <command> [description]'
  log info '  Example:'
  log info "    truenas_cron_create '30 2 * * Sat' 'bash /usr/local/bin/backup.sh' 'Backup'"
}

set_central_timezone () {
  local CST='America/Chicago'
  local current_timezone=$(timedatectl | grep "Time zone" | awk '{print $3}')

  if [ "$current_timezone" = "$CST" ]; then
    log okay 'timezone set correctly'
    return 0
  else
    local chronjobs=$(midclt call cronjob.query)

    if [ "$chronjobs" = "[]" ]; then
      log warn "changing timezone to $CST"
      sudo timedatectl set-timezone "$CST"
    else
      log warn 'You have the following cron jobs:'
      log warn "$cronjobs"

      if is_user_approved "change the timezone to $CST?"; then
        sudo timedatectl set-timezone "$CST"
        return 0
      else
        log info 'adjust cron jobs to the new timezone then '
        log info 'exiting'
        exit 1
      fi
    fi
  fi
}

truenas_cron_create () {
  local schedule="$1"
  local command="$2"
  local description="${3:-}"
  local user

  user=$(whoami)

  if [[ -z "$schedule" || -z "$command" ]]; then
    print_cron_create_help
    return 1
  fi

  local minute hour date month weekday extra

  read -r minute hour date month weekday extra <<<"$schedule"
  if [[ -z "$weekday" || -n "$extra" ]]; then
    log fail 'cron string in wrong format'
    return 1
  fi

  local job_definition

  job_definition=$(jq -n \
    --arg user "$user" \
    --arg command "$command" \
    --arg description "$description" \
    --arg minute "$minute" \
    --arg hour "$hour" \
    --arg date "$date" \
    --arg month "$month" \
    --arg weekday "$weekday" \
    '{
      user: $user,
      command: $command,
      description: $description,
      enabled: true,
      stdout: true,
      stderr: true,
      schedule: {
        minute: $minute,
        hour: $hour,
        dom: $date,
        month: $month,
        dow: $weekday
      }
    }')

  log info "midclt call cronjob.create $job_definition"
  midclt call cronjob.create "$job_definition"
}